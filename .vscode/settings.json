{
    "files.exclude": {
        "out": false,
        "dist": false
    },
    "search.exclude": {
        "out": true,
        "dist": true
    },
    // Turn off compiler task auto detection since npm scripts own the build.
    "js/ts.tsc.autoDetect": "off",
    // Use the TypeScript 7 language server supplied by Microsoft's native preview extension.
    "js/ts.experimental.useTsgo": true
}
